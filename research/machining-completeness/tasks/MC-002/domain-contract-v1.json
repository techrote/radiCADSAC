  "boundary_and_pathology_policy": [
    {
      "case": "coincidence_or_coplanarity",
      "policy": "ordinary input; exact/equality event handling remains a constructive obligation"
    },
    {
      "case": "tangent_or_point_edge_face_contact",
      "policy": "ordinary input; zero-volume contact cannot be promoted to volumetric bridge"
    },
    {
      "case": "sub_tolerance_positive_cut",
      "policy": "ordinary nominal input; may not be collapsed to no-op solely by tolerance"
    },
    {
      "case": "positive_volume_sliver",
      "policy": "ordinary material; regularization does not erase it"
    },
    {
      "case": "self_crossing_retrace_reversal",
      "policy": "ordinary finite trajectory; immutable source intent is preserved"
    },
    {
      "case": "large_finite_segment_count",
      "policy": "ordinary finite history; resource qualification is MC-004/MC-046, not a domain exclusion"
    },
    {
      "case": "whole_body_removal",
      "policy": "valid explicit empty/disappearance transition"
    }
  ],
  "named_domain_decisions": [
    {
      "id": "DD-002-01",
      "topic": "continuous_five_axis_tool_reorientation",
      "status": "excluded_by_current_product_scope",
      "basis": "current MC-1 domain is lathe plus fixed-axis milling; later reoriented setups are admitted, continuous tool-axis reorientation is not silently added"
    },
    {
      "id": "DD-002-02",
      "topic": "additive_material_processes",
      "status": "excluded_by_current_product_scope",
      "basis": "initial programme is removal-focused lathe and mill; additive is future scope"
    },
    {
      "id": "DD-002-03",
      "topic": "deformation_force_chip_dynamics",
      "status": "excluded_by_current_product_scope",
      "basis": "geometry-critical material set is authoritative; force/deformation/chip dynamics are not required for current engineering geometry"
    },
    {
      "id": "DD-002-04",
      "topic": "lathe_live_driven_tooling_as_one_combined_machine_operation",
      "status": "open_product_domain_decision",
      "basis": "lathe and mill families are in scope, but the current contracts do not define whether synchronized driven-tool/live-tool compound kinematics must be one operation or an explicit machine/setup transition; it may not be rejected merely because a provider lacks support"
    },
    {
      "id": "DD-002-05",
      "topic": "multiple_simultaneously_controlled_spindles_or_transfer_machine_semantics",
      "status": "open_product_domain_decision",
      "basis": "ordinary single-spindle lathe plus re-clamp/re-chuck histories are defined; multi-spindle transfer-machine semantics need explicit product intent before becoming mandatory constructors"
    }
  ],
  "coverage_rule": {
    "required_operation_ids": [
      "lathe_od_turning",
      "lathe_facing",
      "lathe_shoulder",
      "lathe_taper_chamfer_profile",
