{
  "schema": "radicadsac-mc-domain-contract/1.0",
  "task": "MC-002",
  "status": "reviewed-domain-artifact",
  "source_baseline": "b4184c3a65123df0f54f93c50fab223cc9e4de4d",
  "authority": [
    "docs/00-FOUNDING-BRIEF.md",
    "docs/01-MSAC-GEOMETRY-CONTRACT.md",
    "docs/machining-completeness/00-PROGRAMME.md",
    "docs/machining-completeness/01-DOMAIN-AND-SEMANTICS.md",
    "docs/decisions/DR-0026-machining-completeness-programme.md"
  ],
  "domain_rule": {
    "candidate_independent": true,
    "finite_source_description_required": true,
    "solver_success_is_not_validity_or_admissibility": true,
    "missing_constructor_is_gap_not_automatic_exclusion": true,
    "initial_machine_families": [
      "lathe",
      "mill"
    ],
    "milling_axis_policy": "tool axis is fixed within one admitted three-axis milling operation; later setup reorientation is explicit and permitted",
    "history": "finite ordered manufacturing history with immutable source intent and explicit body/setup targets"
  },
  "constructors": {
    "stock": [
      {
        "id": "bounded_stock",
        "semantics": "bounded regular volumetric material with explicit units, workpiece frame and durable body identity"
      },
      {
        "id": "imported_stock",
        "semantics": "bounded closed/oriented imported material with explicit units, representation and source-uncertainty contract; import success alone is not validity"
      }
    ],
    "cutting_solid": [
      {
        "id": "lathe_external_insert",
        "semantics": "finite external turning cutting region, including declared nose radius/profile and non-cutting holder region"
      },
      {
        "id": "lathe_internal_tool",
        "semantics": "finite internal boring/turning cutting region with access and holder clearance witness"
      },
      {
        "id": "lathe_groove_part_tool",
        "semantics": "finite grooving/parting cutting region capable of complete separation"
      },
      {
        "id": "lathe_form_tool",
        "semantics": "finite formed cutting region; nonconvexity is permitted when physical access is witnessed"
      },
      {
        "id": "mill_flat_end",
        "semantics": "finite fixed-axis flat-end cutting solid"
      },
      {
        "id": "mill_corner_radius",
        "semantics": "finite fixed-axis corner-radius cutting solid"
      },
      {
        "id": "mill_ball_round",
        "semantics": "finite fixed-axis ball/rounded cutting solid"
      },
      {
        "id": "mill_drill",
        "semantics": "finite fixed-axis drill cutting solid"
      },
      {
        "id": "mill_form",
        "semantics": "finite fixed-axis form/countersink/chamfer-style cutting solid"
      },
      {
        "id": "mill_accessible_undercut",
        "semantics": "finite fixed-axis undercut/nonconvex cutting region with explicit access and non-cutting-body clearance witness"
      }
    ],
    "trajectory": [
      {
        "id": "stationary",
        "semantics": "finite-duration constant pose; engaged stationary contact/removal is valid and not dropped"
      },
      {
        "id": "line",
        "semantics": "continuous finite line segment with explicit endpoints"
      },
      {
        "id": "circular_arc",
        "semantics": "continuous finite oriented arc with explicit endpoints and sweep sense"
      },
      {
        "id": "polyline",
        "semantics": "finite ordered continuous composition of line segments"
      },
      {
        "id": "spline",
        "semantics": "finite explicitly defined continuous spline/curve; exact numeric representation is owned by MC-003"
      },
      {
        "id": "piecewise_motion",
        "semantics": "finite continuous composition of admitted trajectory pieces preserving semantic boundaries"
      },
      {
        "id": "timed_phase_motion",
        "semantics": "finite motion retaining time/spindle-angle correlation where material sweep depends on phase"
      }
    ],
    "engagement": [
      {
        "id": "engagement_interval",
        "semantics": "closed/open endpoint policy is explicit; only engaged intervals contribute cutting sweep"
      },
      {
        "id": "engagement_boundary",
        "semantics": "entry/exit is preserved as a semantic boundary even when geometrically tangent or redundant"
      }
    ],
    "lathe_kinematics": [
      {
        "id": "spindle_rotation",
        "semantics": "explicit workpiece rotation about a declared spindle axis with finite angle/time law"
      },
      {
        "id": "turning_feed",
        "semantics": "tool motion relative to rotating target in the common workpiece frame"
      },
      {
        "id": "phase_synchronization",
        "semantics": "spindle/feed correlation retained rather than replaced by independent full-angle coverage"
      },
      {
        "id": "eccentric_setup",
        "semantics": "explicit noncoaxial workholding transform; must use full phase-sensitive sweep when rotational reduction is invalid"
      }
    ],
    "setup": [
      {
        "id": "rigid_setup_transform",
        "semantics": "explicit rigid transform between machine/setup and common workpiece frame"
      },
      {
        "id": "reclamp",
        "semantics": "explicitly select a durable material body, establish new workholding and transform, then continue machining"
      },
      {
        "id": "machine_transition",
        "semantics": "explicit lathe↔mill transition preserving common-frame/body identities and immutable history"
      }
    ],
    "material": [
      {
        "id": "regularized_removal",
        "semantics": "M_next = closure(interior(M \\ S)); lower-dimensional debris may vanish, positive-volume material may not be erased by policy"
      },
      {
        "id": "body_split",
        "semantics": "connectivity-changing removal creates explicit durable body transition; no largest-body discard rule"
      },
      {
        "id": "body_disappearance",
        "semantics": "complete removal yields explicit empty material/body disappearance, not an invented residual"
      },
      {
        "id": "body_target",
        "semantics": "every machining operation names the durable target body/body set valid for that setup"
      }
    ]
  },
  "physical_validity": {
    "stock_is_bounded_volumetric_material": true,
    "tool_cutting_and_noncutting_regions_are_distinguished": true,
    "finite_cutter_extent_is_required": true,
    "engaged_motion_is_continuous": true,
    "engaged_teleportation_is_invalid": true,
    "stationary_engaged_motion_is_valid": true,
    "machine_travel_and_kinematic_feasibility_are_witnessed": true,
    "access_and_holder_fixture_clearance_are_witnessed_where_relevant": true,
    "detached_body_requires_workholding_or_explicit_reclamp_before_further_machining": true,
    "parted_body_is_not_magically_fixed": true,
    "candidate_success_is_not_a_physical_validity_oracle": true,
    "point_or_edge_contact_creates_volumetric_connection": false,
    "face_contact_requires_local_interior_analysis": true,
    "durable_bodies_do_not_merge_only_because_boundaries_touch": true,
    "positive_volume_slivers_are_material": true,
    "empty_material_state_is_valid": true,
    "units_frames_tool_revision_setup_revision_and_target_body_are_explicit": true
  },
