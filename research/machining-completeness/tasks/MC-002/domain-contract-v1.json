      "mill_simultaneous_xyz",
      "mill_retrace_self_cross_stationary",
      "mill_cutthrough_multibody",
      "reclamp_reorient_continue",
      "lathe_mill_lathe_history",
      "machine_separated_retained_body",
      "complete_body_removal"
    ],
    "ordinary_operation_coverage": "every required operation is admitted through explicit constructors; anything not yet fixed by product scope must be represented by a named domain decision and may not be silently removed from the denominator",
    "no_provider_narrowing": true
  },
  "downstream_obligations": {
    "MC-003": [
      "exact parameter/coefficient domains",
      "curve/arc/spline semantics",
      "timing/phase numeric representation",
      "rigid-transform encoding",
      "legacy journal compatibility"
    ],
    "MC-004": [
      "intended session workloads",
      "accuracy vectors",
      "reference hardware",
      "time/memory envelopes"
    ],
    "MC-005": [
      "integrate MC-002/003/004 and decide MC-A; this artifact alone does not accept MC-A"
    ],
    "MC-006_to_MC-008": [
      "constructive/termination routes for admitted constructors"
    ],
    "MC-018_to_MC-023": [
      "actual cutter/tool sweep realization and setup composition"
    ],
    "MC-054": [
      "engineering-output profile for singular/grouped material states"
    ]
  }
}
