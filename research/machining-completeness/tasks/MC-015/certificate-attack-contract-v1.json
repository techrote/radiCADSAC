  "checker_contract": {
    "schema": "radicadsac-mc015-certificate/1.0",
    "canonical_numeric_authority": "integers and exact rational strings only; binary float authority forbidden",
    "material_certificate": "independently evidenced L subset nominal M subset U and L subset candidate B subset U; exact band volume equals volume(U)-volume(L) and may not exceed the preregistered symmetric-difference allowance",
    "non_compensating_obligations": [
      "required material/void/boundary probes match exactly",
      "component count matches exactly",
      "all required durable body identities survive, including exhausted identities",
      "durable lineage is preserved",
      "non-success terminals remain incomplete",
      "candidate, checker and independent oracle authorities remain distinct"
    ],
    "scope_limit": "The checker validates the recorded certificate mathematics, authorities and discriminating witnesses. It does not prove that the witness set is complete, implement native geometry, qualify STEP, or establish MC-B/MC-1."
  },
  "required_corruptions": [
    "binary floating authority",
    "timeout or resource exhaustion promoted to success",
    "candidate-owned checker or expected truth",
    "non-independent oracle declaration",
    "shared decisive candidate/oracle geometry",
    "candidate-owned inclusion proof",
    "inverted or inconsistent material sandwich",
    "nominal or candidate material outside the sandwich",
    "incorrect or over-broad uncertainty band",
    "unproved sandwich relation",
    "lost positive thin material",
    "filled required void/channel",
    "tangent/boundary collapse",
    "wrong component count or added bridge",
    "lost durable body identity",
    "lost durable lineage",
    "positive residual rounded to empty",
    "duplicate witness identity",
    "protected dependency/oracle/historical-import source drift"
  ],
  "boundary_controls": [
    "exact 1/1000000 positive material remains positive",
    "exact boundary/tangent state remains distinct from material and void",
    "valid exact-empty material can PASS while durable exhausted body identity remains recorded",
    "F01-F16 remain mandatory BUILT fixtures rather than becoming candidate PASS records"
  ],
  "protected_semantics": {
    "historical_genesis_and_rcs_evidence_unchanged": true,
    "canonical_journal_meaning_unchanged": true,
    "source_audio_provenance_semantics_unchanged": true,
    "positive_volume_material_not_discarded": true,
    "durable_body_and_lineage_semantics_unchanged": true,
    "negative_and_incomplete_results_preserved": true,
    "candidate_output_never_expected_truth": true,
    "native_or_paid_execution": false
  },
