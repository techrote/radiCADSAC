    "material_semantics": "regularized-volumetric-rCS009",
    "step_contract": "msac-step-conformance/1.0",
    "volume_compare_abs_mm3": 1e-05,
    "bbox_compare_abs_mm": 1e-05,
    "step_volume_abs_mm3": 1e-05,
    "step_bbox_abs_mm": 1e-05
  },
  "strategies": [
    {
      "id": "explicit_analytic",
      "hierarchy_level": 1,
      "description": "Explicitly tagged or strictly proven analytic operation; direct primitive material-removal envelope."
    },
    {
      "id": "segment_sweep",
      "hierarchy_level": 2,
      "description": "Exact fixed-orientation cutter envelope per canonical segment with one material cut per segment."
    },
    {
      "id": "canonical_batch",
      "hierarchy_level": 3,
      "description": "Deterministically simplify equivalent collinear/duplicate canonical samples, then subtract all exact segment envelopes in one Boolean."
    },
    {
      "id": "freehand_batch",
      "hierarchy_level": 4,
      "description": "Preserve arbitrary canonical polyline segments, including crossing/retrace, and subtract their exact fixed-orientation envelope set in one Boolean."
    },
    {
      "id": "sampled_fallback",
      "hierarchy_level": 5,
      "description": "Backend-local sampled cutter poses with an explicit under-approximation bound; negative fidelity evidence is retained rather than silently accepted."
    }
  ],
  "profiles": {
    "smoke": [
      "drill-explicit",
